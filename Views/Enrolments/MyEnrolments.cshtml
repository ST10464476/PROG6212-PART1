@model List<RaceDay.Web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My Event Enrolments</h2>
    <p>Here you can view the events you have registered for.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Enrolment ID</th>
                    <th>Event ID</th>
                    <th>Category ID</th>
                    <th>Race Number</th>
                    <th>Enrolment Date</th>
                    <th>Payment Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var enrolment in Model)
                {
                    <tr>
                        <td>@enrolment.EnrolmentID</td>
                        <td>@enrolment.EventID</td>
                        <td>@enrolment.CategoryID</td>
                        <td>@enrolment.RaceNumber</td>
                        <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge bg-warning text-dark">
                                @enrolment.PaymentStatus
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }

    <a href="/Events/Index" class="btn btn-primary">
        Browse Events
    </a>
</div>