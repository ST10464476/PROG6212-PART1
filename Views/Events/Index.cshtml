@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Events";
    var role = Context.Session.GetString("Role");
}

<div class="container mt-4">

    <div class="p-4 mb-4 bg-dark text-white rounded shadow">
        <h1>RaceDay Events</h1>
        <p class="mb-0">
            Discover upcoming running, walking and cycling events.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="card shadow h-100">

                        @* Event Banner *@
                        @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                        {
                            <img src="@item.BannerImageUrl"
                                 class="card-img-top"
                                 alt="@item.EventName banner"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white text-center p-5">
                                <h5>RaceDay Event</h5>
                                <p class="mb-0">Event banner coming soon</p>
                            </div>
                        }

                        <div class="card-body">

                            <h4 class="card-title">
                                @item.EventName
                            </h4>

                            <p>@item.Description</p>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @item.Distance km
                            </p>

                            <p>
                                <strong>Entry Fee:</strong>
                                R @item.EntryFee
                            </p>

                            <span class="badge bg-success">
                                @item.Status
                            </span>

                            @if (role == "Participant")
                            {
                                <div class="mt-3">
                                    <a asp-controller="Events"
                                       asp-action="Details"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-success w-100">
                                        View Details & Enrol
                                    </a>
                                </div>
                            }

                            @if (role == "Organiser")
                            {
                                <div class="mt-3 d-flex gap-2">

                                    <a asp-controller="Events"
                                       asp-action="Edit"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-primary btn-sm">
                                        Edit Event
                                    </a>

                                    <form asp-controller="Events"
                                          asp-action="Delete"
                                          asp-route-id="@item.EventID"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Delete Event
                                        </button>

                                    </form>

                                </div>
                            }

                        </div>
                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4 mb-4">

        @if (role == "Organiser")
        {
            <a asp-controller="Organiser"
               asp-action="Dashboard"
               class="btn btn-secondary">
                Back to Dashboard
            </a>
        }
        else
        {
            <a asp-controller="Participant"
               asp-action="Dashboard"
               class="btn btn-secondary">
                Back to Dashboard
            </a>
        }

    </div>

</div>
