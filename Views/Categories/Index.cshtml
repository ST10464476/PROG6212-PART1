@model List<RaceDay.Web.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    var events = ViewBag.Events as List<RaceDay.Web.Models.EventViewModel>;
    int? selectedEventID = ViewBag.SelectedEventID as int?;
}

<div class="container mt-4">

    <div class="p-4 mb-4 bg-dark text-white rounded">
        <h1>Manage Event Categories</h1>
        <p>Create and manage running, walking and cycling categories.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            <h5>Select an Event</h5>

            <form asp-controller="Categories" asp-action="Index" method="get">
                <select name="eventId" class="form-select mb-3">
                    <option value="">-- Select an event --</option>

                    @if (events != null)
                    {
                        @foreach (var eventItem in events)
                        {
                            <option value="@eventItem.EventID"
                                    selected="@(selectedEventID == eventItem.EventID)">
                                @eventItem.EventName
                            </option>
                        }
                    }
                </select>

                <button type="submit" class="btn btn-primary">
                    View Categories
                </button>
            </form>
        </div>
    </div>

    @if (selectedEventID != null)
    {
        <div class="mb-3">
            <a asp-controller="Categories"
               asp-action="Create"
               asp-route-eventId="@selectedEventID"
               class="btn btn-success">
                Add New Category
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No categories have been added to this event yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped shadow">
                    <thead class="table-dark">
                        <tr>
                            <th>Category</th>
                            <th>Distance</th>
                            <th>Minimum Age</th>
                            <th>Maximum Age</th>
                            <th>Entry Fee</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.CategoryName</td>
                                <td>@category.Distance km</td>
                                <td>@category.AgeMin</td>
                                <td>@category.AgeMax</td>
                                <td>R @category.EntryFee</td>

                                <td>
                                    <a asp-controller="Categories"
                                       asp-action="Edit"
                                       asp-route-id="@category.CategoryID"
                                       class="btn btn-primary btn-sm">
                                        Edit
                                    </a>

                                    <form asp-controller="Categories"
                                          asp-action="Delete"
                                          asp-route-id="@category.CategoryID"
                                          asp-route-eventId="@selectedEventID"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this category?');">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>
