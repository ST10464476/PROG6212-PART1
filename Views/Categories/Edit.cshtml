@model RaceDay.Web.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h2>Edit Event Category</h2>
            <p class="mb-0">Update the category details below.</p>
        </div>

        <div class="card-body">

            <form asp-controller="Categories"
                  asp-action="Edit"
                  asp-route-id="@Model.CategoryID"
                  method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="CategoryID" />
                <input type="hidden" asp-for="EventID" />

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label">Category Name</label>
                    <input asp-for="CategoryName" class="form-control" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Distance" class="form-label">Distance (km)</label>
                    <input asp-for="Distance" type="number" step="0.1"
                           class="form-control" />
                    <span asp-validation-for="Distance" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AgeMin" class="form-label">Minimum Age</label>
                        <input asp-for="AgeMin" type="number" class="form-control" />
                        <span asp-validation-for="AgeMin" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AgeMax" class="form-label">Maximum Age</label>
                        <input asp-for="AgeMax" type="number" class="form-control" />
                        <span asp-validation-for="AgeMax" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="EntryFee" class="form-label">Entry Fee (R)</label>
                    <input asp-for="EntryFee" type="number" step="0.01"
                           class="form-control" />
                    <span asp-validation-for="EntryFee" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    Save Changes
                </button>

                <a asp-controller="Categories"
                   asp-action="Index"
                   asp-route-eventId="@Model.EventID"
                   class="btn btn-secondary">
                    Back to Categories
                </a>

            </form>
        </div>
    </div>
</div>
