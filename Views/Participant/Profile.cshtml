@model RaceDay.Web.Models.ParticipantProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <div class="p-4 mb-4 bg-dark text-white rounded shadow">
        <h1>My Participant Profile</h1>
        <p class="mb-0">Manage your personal information.</p>
    </div>

    @if (TempData["ProfileMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["ProfileMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow p-4">

        <form asp-controller="Participant"
              asp-action="UpdateProfile"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="UserID" />
            <input type="hidden" asp-for="Email" />

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">
                    First Name
                </label>
                <input asp-for="FirstName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">
                    Last Name
                </label>
                <input asp-for="LastName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">
                    Phone Number
                </label>
                <input asp-for="PhoneNumber" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

            <a asp-controller="Participant"
               asp-action="Dashboard"
               class="btn btn-secondary">
                Back to Dashboard
            </a>

        </form>

    </div>

</div>