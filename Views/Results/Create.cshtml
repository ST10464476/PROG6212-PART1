@model RaceDay.Web.Models.ResultViewModel

@{
    ViewData["Title"] = "Add Result";
}

<h2>Add Race Result</h2>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="EnrolmentID" />
    <input type="hidden" name="eventId" value="@ViewBag.EventID" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FinishTime">Finish Time</label>
        <input asp-for="FinishTime" type="time" step="1"
               class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Position">Position</label>
        <input asp-for="Position" type="number" min="1"
               class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="AveragePace">Average Pace</label>
        <input asp-for="AveragePace" type="number" step="0.01"
               class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="ResultStatus">Result Status</label>
        <select asp-for="ResultStatus" class="form-select">
            <option value="Completed">Completed</option>
            <option value="Did Not Finish">Did Not Finish</option>
            <option value="Disqualified">Disqualified</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Result</button>
</form>